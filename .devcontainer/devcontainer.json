// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "avo",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"remoteUser": "bun",

	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// node_modules lives in the workspace, so install once the source is mounted.
	"postCreateCommand": "bun install --frozen-lockfile",

	// Keep Claude Code's login, settings and memory across container rebuilds.
	"mounts": ["source=avo-claude,target=/home/bun/.claude,type=volume"],
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/bun/.claude"
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"biomejs.biome",
				"oven.bun-vscode"
			],
			"settings": {
				"editor.defaultFormatter": "biomejs.biome"
			}
		}
	}
}
